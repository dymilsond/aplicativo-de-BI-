# Copie este arquivo para `.env` e troque o valor.
#
#   Windows PowerShell:  Copy-Item .env.exemplo .env
#   Linux/Mac:           cp .env.exemplo .env
#
# Gere a sua chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# O arquivo .env NÃO vai para o Git (está no .gitignore).
CHAVE_DA_SESSAO=troque-isto-por-uma-chave-gerada
